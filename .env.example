VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — enables email notifications for Contact / Custom Request / Artwork
# Inquiry forms (all three ALWAYS save to Supabase & show in /admin regardless
# of this). Get these from https://www.emailjs.com after creating a free
# account, an Email Service, and an Email Template. See SUPABASE_SETUP_GUIDE.md.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-side only — used by netlify/functions/submit-form.js.
# Do NOT prefix these with VITE_ — that prefix tells Vite to bundle a value
# into the client-side JS, which would ship your service_role key to every
# visitor's browser. Set these in Netlify's dashboard under
# Site settings -> Environment variables (NOT in a committed .env file),
# scoped to "Functions" (or "All scopes") — never "Vite"/build-time only.
# See PATCH_NOTES.md for the full setup steps.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_ORIGIN=
